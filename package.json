{
  "name": "vue-starter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "paraglide-js compile --project ./project.inlang --outdir ./src/shared/lib/i18n && run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "i18n": "npx @inlang/cli machine translate --project ./project.inlang",
    "test": "run-p \"test.*\"",
    "test.unit": "vitest run",
    "test.e2e": "playwright test",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "commit": "czg",
    "prepare": "husky",
    "setup-playwright": "playwright install --with-deps",
    "postinstall": "paraglide-js compile --project ./project.inlang --outdir ./src/shared/lib/i18n",
    "---------FMT FIX-----------": "Fmt check and fix vaid code",
    "fmt.fix": "run-s \"fmt.fix.*\"",
    "fmt.fix.prettier": "prettier --write \"src/**/*.vue\"",
    "fmt.fix.biome": "biome format --write ./src",
    "---------FMT CHECK-----------": "Fmt check vaid code only",
    "fmt.check": "run-s \"fmt.check.*\"",
    "fmt.check.biome": "biome format ./src",
    "---------LINT FIX-----------": "Lint check and fix vaid code",
    "lint.fix": "run-s \"lint.fix.*\"",
    "lint.fix.eslint": "eslint \"src/**/*.vue\" --fix",
    "lint.fix.biome": "biome check --write --unsafe ./src",
    "---------LINT CHECK-----------": "Lint check vaid code only",
    "lint.check": "run-s \"lint.check.*\"",
    "lint.check.eslint": "eslint  \"src/**/*.vue\"  --max-warnings=0",
    "lint.check.biome": "biome check ./src"
  },
  "dependencies": {
    "@ark-ui/vue": "^4.2.0",
    "@pinia/colada": "^0.13.3",
    "@vuepic/vue-datepicker": "^10.0.0",
    "@vueuse/core": "^11.2.0",
    "air-datepicker": "^3.5.3",
    "axios": "^1.7.7",
    "chart.js": "^4.4.6",
    "chartjs-plugin-stacked100": "^1.7.0",
    "cva": "npm:class-variance-authority@^0.7.0",
    "date-fns": "^4.1.0",
    "js-cookie": "^3.0.5",
    "nanoid": "^5.0.8",
    "pinia": "^2.2.6",
    "qrcode.vue": "^3.6.0",
    "query-string": "^9.1.1",
    "reka-ui": "^1.0.0-alpha.7",
    "tailwind-merge": "^2.5.4",
    "valibot": "^1.0.0-beta.3",
    "vue": "^3.5.12",
    "vue-qrcode-reader": "^5.7.1",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@iconify-json/flag": "^1.2.3",
    "@iconify-json/logos": "^1.2.3",
    "@iconify-json/lucide": "^1.2.12",
    "@inlang/paraglide-js": "2.0.0-beta.22",
    "@mdx-js/rollup": "^3.1.0",
    "@mdx-js/vue": "^3.1.0",
    "@playwright/test": "^1.48.2",
    "@tailwindcss/postcss": "^4.0.0-beta.9",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.0.0-beta.9",
    "@tsconfig/node22": "^22.0.0",
    "@types/js-cookie": "^3.0.6",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.17.6",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vitejs/plugin-vue-jsx": "^4.0.1",
    "@vitest/eslint-plugin": "1.1.7",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.5.1",
    "czg": "1.10.1",
    "daisyui": "^5.0.0-beta.6",
    "eslint": "^9.14.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "eslint-plugin-vue": "^9.30.0",
    "husky": "^9.1.6",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.10",
    "npm-run-all2": "^7.0.1",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-toc": "^9.0.0",
    "tailwindcss": "^4.0.0-beta.9",
    "typescript": "~5.6.3",
    "unplugin-icons": "^0.20.1",
    "unplugin-vue-router": "^0.11.1",
    "vite": "^5.4.10",
    "vite-plugin-vue-devtools": "^7.5.4",
    "vitest": "^2.1.4",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.8.1",
  "lint-staged": {
    "*.vue": [
      "eslint --fix",
      "eslint --max-warnings=0",
      "prettier --write",
      "prettier --check"
    ],
    "*.ts": [
      "biome format --write --no-errors-on-unmatched",
      "biome check --write --unsafe --no-errors-on-unmatched"
    ]
  }
}
